# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://sridevinightchart.com
# Contact email shown on About / Contact pages
NEXT_PUBLIC_CONTACT_EMAIL=sridevinightchart@gmail.com
# Admin login password (use a long random string)
ADMIN_PASSWORD=change-me-to-a-long-random-string
# Secret used to sign the admin session cookie (another long random string)
SESSION_SECRET=change-me-too
# Optional: path to the SQLite database file
DB_PATH=./data/sridevi-night.db

# The site reads committed data/results.json; Vercel needs no DB_PATH.
# Optional supported dated feeds for the local/GitHub updater:
RESULT_SOURCE_URL=https://matka-tips.org/record-chart/sridevi-night-jodi
RESULT_SOURCE_URL2=https://khabar.bet/sridevi-night-matka-chart
